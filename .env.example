# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Password gate: AUTH_SECRET via `openssl rand -hex 32`,
# APP_PASSWORD is the initial family password (changeable in /admin)
AUTH_SECRET=
APP_PASSWORD=

# Only for local DB scripts (scripts/db.mjs, scripts/seed-airports.mjs), not needed on Vercel.
# Supabase → Project Settings → Database
SUPABASE_DB_PASSWORD=
# Optional: session pooler host if the direct DB host is unreachable,
# e.g. aws-0-<region>.pooler.supabase.com
SUPABASE_DB_HOST=

# Optional
# Public URL of the deployment (Open Graph images); falls back to VERCEL_URL
NEXT_PUBLIC_SITE_URL=
# Contact (e-mail or URL) sent to Nominatim in the geocoding User-Agent
NOMINATIM_CONTACT=
